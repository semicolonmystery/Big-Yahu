# Discord Developer Portal -> your app -> Bot -> Reset Token.
# Enable both "Message Content Intent" and "Presence Intent" on that same page.
# Leave the token empty to run only the admin panel.
DISCORD_TOKEN=

# Required when DISCORD_TOKEN is set. This instance serves exactly this server;
# missing/invalid configuration stops startup rather than serving every guild.
# Right-click the server in Discord -> Copy Server ID (needs Developer Mode).
DISCORD_GUILD_ID=

# Required when DISCORD_TOKEN is set. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Everything below is optional.
#
# Under Docker Compose, Chroma is reached over the compose network and needs no
# configuration here. These only matter when running the server outside Docker
# with `npm run dev`, and even then the defaults (localhost:8000) are usually
# right — see docker-compose.dev.yml.
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# Keep an existing deployment's Chroma image here until its data is backed up
# and an upgrade is planned. Compose otherwise uses a pinned stable release.
# CHROMA_IMAGE=chromadb/chroma:1.5.9

# SQLITE_PATH=./data/big-yahu.sqlite3
# PORT=3000

# How many reverse proxies sit in front of this instance. Leave it at 0 when
# nothing does, which is what `docker compose up` gives you. Set it to 1 behind
# a single nginx, 2 behind nginx behind Cloudflare, and so on.
#
# It has to be a count because X-Forwarded-For is a list the client can prepend
# to: trusting the whole header lets anyone claim any address, which would let
# them walk around the sign-in rate limit. The count says how many entries from
# the right are yours. Getting it too high throttles by the wrong address;
# getting it too low throttles everyone together. It also decides whether the
# session cookie is marked Secure, via X-Forwarded-Proto.
# TRUSTED_PROXY_HOPS=0

# Encrypts plugin secrets. 64 hex characters. If unset, a key is generated
# beside the database on first use — back it up, because losing it makes every
# stored plugin secret unreadable.
# PLUGIN_ENV_KEY=
